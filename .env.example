# Database Configuration (PostgreSQL Source)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_db

# Google Cloud & BigQuery Configuration
GCP_PROJECT=upbeat-repeater-477110-q6
GCP_REGION=us-central1
BIGQUERY_DATASET=analytics
BIGQUERY_TABLE=fct_sales_orders

# Serverless Auto-Boot Execution Configuration
AUTO_BOOT_ETL=true
PORT=8080

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
