# Environment variables for local development.
# Copy to .env and adjust values:  cp .env.example .env

# Database connection string
DATABASE_URL=sqlite:///./cafe_portal.db
# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-key-change-in-production-cafe-portal-2026
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# Read by the backend code (AWS_REGION)
AWS_REGION=us-east-1
# Read by the backend code (S3_BUCKET_NAME)
S3_BUCKET_NAME=cafe-interior-portal-assets
# Read by the backend code (TESTING)
TESTING=changeme
