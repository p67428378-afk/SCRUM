  "components": {
    "schemas": {
      "DashboardAnalytics": {
        "properties": {
          "today_revenue": {
            "type": "number",
            "title": "Today Revenue"
          },
          "completed_orders": {
            "type": "integer",
            "title": "Completed Orders"
          },
          "active_orders": {
            "type": "integer",
            "title": "Active Orders"
          },
          "occupied_tables": {
            "type": "integer",
            "title": "Occupied Tables"
          },
          "total_tables": {
            "type": "integer",
            "title": "Total Tables"
          },
          "occupancy_rate": {
            "type": "number",
            "title": "Occupancy Rate"
          },
          "top_selling_items": {
            "items": {
              "$ref": "#/components/schemas/TopSellingItem"
            },
            "type": "array",
            "title": "Top Selling Items",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "today_revenue",
          "completed_orders",
          "active_orders",
          "occupied_tables",
          "total_tables",
          "occupancy_rate"
        ],
        "title": "DashboardAnalytics"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MenuItemCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "example": "Iced Latte"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "example": "Beverages"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price",
            "example": 4.5
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "example": "Espresso with milk over ice"
          },
          "is_available": {
            "type": "boolean",
            "title": "Is Available",
            "default": true,
            "example": true
          }
        },
        "type": "object",
        "required": [
          "name",
          "category",
          "price"
        ],
        "title": "MenuItemCreate"
      },
      "MenuItemResponse": {
        "properties": {
