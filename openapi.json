{
  "openapi": "3.1.0",
  "info": {
    "title": "DG Cluster Assortment Advisor API",
    "description": "Decision-support tool for Dollar General category managers",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/kpis": {
      "get": {
        "summary": "Get Kpis",
        "operationId": "get_kpis_api_v1_kpis_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KPISchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/skus": {
      "get": {
        "summary": "Get Skus",
        "operationId": "get_skus_api_v1_skus_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Per Page"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sort By"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sort Order"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SKUListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios/{scenario_name}": {
      "get": {
        "summary": "Get Scenario",
        "operationId": "get_scenario_api_v1_scenarios__scenario_name__get",
        "parameters": [
          {
            "name": "scenario_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortments": {
      "post": {
        "summary": "Submit Assortment",
        "operationId": "submit_assortment_api_v1_assortments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssortmentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssortmentSubmitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortments/{transaction_id}": {
      "get": {
        "summary": "Get Assortment",
        "operationId": "get_assortment_api_v1_assortments__transaction_id__get",
        "parameters": [
          {
            "name": "transaction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Transaction Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssortmentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionsSummary": {
        "properties": {
          "adds": {
            "type": "integer",
            "title": "Adds"
          },
          "removals": {
            "type": "integer",
            "title": "Removals"
          },
          "swaps": {
            "type": "integer",
            "title": "Swaps"
          }
        },
        "type": "object",
        "required": [
          "adds",
          "removals",
          "swaps"
        ],
        "title": "ActionsSummary"
      },
      "AssortmentActionResponse": {
        "properties": {
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          },
          "action_type": {
            "type": "string",
            "title": "Action Type"
          }
        },
        "type": "object",
        "required": [
          "sku_id",
          "action_type"
        ],
        "title": "AssortmentActionResponse"
      },
      "AssortmentCreate": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          }
        },
        "type": "object",
        "required": [
          "scenario_name"
        ],
        "title": "AssortmentCreate"
      },
      "AssortmentResponse": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/AssortmentActionResponse"
            },
            "type": "array",
            "title": "Actions",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "scenario_name",
          "status",
          "summary",
          "created_at"
        ],
        "title": "AssortmentResponse"
      },
      "AssortmentSubmitResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "summary",
          "timestamp",
          "transaction_id"
        ],
        "title": "AssortmentSubmitResponse"
      },
      "GuardrailCheck": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "name",
          "status",
          "value"
        ],
        "title": "GuardrailCheck"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KPISchema": {
        "properties": {
          "sales_per_linear_ft": {
            "type": "number",
            "title": "Sales Per Linear Ft"
          },
          "private_brand_pct": {
            "type": "number",
            "title": "Private Brand Pct"
          },
          "in_stock_rate": {
            "type": "number",
            "title": "In Stock Rate"
          },
          "shelf_capacity": {
            "type": "number",
            "title": "Shelf Capacity"
          }
        },
        "type": "object",
        "required": [
          "sales_per_linear_ft",
          "private_brand_pct",
          "in_stock_rate",
          "shelf_capacity"
        ],
        "title": "KPISchema"
      },
      "SKUListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SKUResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "per_page": {
            "type": "integer",
            "title": "Per Page"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "page",
          "per_page",
          "total"
        ],
        "title": "SKUListResponse"
      },
      "SKUResponse": {
        "properties": {
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "weekly_sales": {
            "type": "number",
            "title": "Weekly Sales"
          },
          "profit_margin": {
            "type": "number",
            "title": "Profit Margin"
          },
          "private_brand": {
            "type": "boolean",
            "title": "Private Brand"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "sku_id",
          "name",
          "weekly_sales",
          "profit_margin",
          "private_brand",
          "status"
        ],
        "title": "SKUResponse"
      },
      "ScenarioResponse": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "projected_sales_change_pct": {
            "type": "number",
            "title": "Projected Sales Change Pct"
          },
          "projected_private_brand_pct": {
            "type": "number",
            "title": "Projected Private Brand Pct"
          },
          "projected_shelf_capacity": {
            "type": "number",
            "title": "Projected Shelf Capacity"
          },
          "actions_summary": {
            "$ref": "#/components/schemas/ActionsSummary"
          },
          "guardrails": {
            "items": {
              "$ref": "#/components/schemas/GuardrailCheck"
            },
            "type": "array",
            "title": "Guardrails"
          }
        },
        "type": "object",
        "required": [
          "scenario_name",
          "projected_sales_change_pct",
          "projected_private_brand_pct",
          "projected_shelf_capacity",
          "actions_summary",
          "guardrails"
        ],
        "title": "ScenarioResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}