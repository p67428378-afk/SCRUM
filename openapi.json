{
  "openapi": "3.1.0",
  "info": {
    "title": "Actress Portfolio API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/credits": {
      "get": {
        "summary": "List Credits",
        "operationId": "list_credits_api_v1_credits_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Category filter (film, television, theater, commercials)",
              "title": "Category"
            },
            "description": "Category filter (film, television, theater, commercials)"
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreditListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/gallery": {
      "get": {
        "summary": "List Gallery",
        "operationId": "list_gallery_api_v1_gallery_get",
        "parameters": [
          {
            "name": "media_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Media type filter (headshot, reel, press_kit)",
              "title": "Media Type"
            },
            "description": "Media type filter (headshot, reel, press_kit)"
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaAssetListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/contact": {
      "post": {
        "summary": "Submit Contact Inquiry",
        "operationId": "submit_contact_inquiry_api_v1_contact_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactInquiryCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactInquiryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContactInquiryCreate": {
        "properties": {
          "sender_name": {
            "type": "string",
            "minLength": 1,
            "title": "Sender Name",
            "description": "Sender's full name"
          },
          "sender_email": {
            "type": "string",
            "format": "email",
            "title": "Sender Email",
            "description": "Valid sender email address"
          },
          "project_type": {
            "type": "string",
            "minLength": 1,
            "title": "Project Type",
            "description": "Type of project (e.g. Film, TV)"
          },
          "budget": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget"
          },
          "project_dates": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Dates"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message",
            "description": "Inquiry message / character breakdown"
          }
        },
        "type": "object",
        "required": [
          "sender_name",
          "sender_email",
          "project_type",
          "message"
        ],
        "title": "ContactInquiryCreate"
      },
      "ContactInquiryResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "success"
          },
          "inquiry_id": {
            "type": "string",
            "title": "Inquiry Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          }
        },
        "type": "object",
        "required": [
          "inquiry_id",
          "message",
          "submitted_at"
        ],
        "title": "ContactInquiryResponse"
      },
      "CreditListResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "credits": {
            "items": {
              "$ref": "#/components/schemas/CreditResponse"
            },
            "type": "array",
            "title": "Credits"
          }
        },
        "type": "object",
        "required": [
          "total",
          "credits"
        ],
        "title": "CreditListResponse"
      },
      "CreditResponse": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category"
          },
          "production_title": {
            "type": "string",
            "title": "Production Title"
          },
          "role_name": {
            "type": "string",
            "title": "Role Name"
          },
          "role_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role Type"
          },
          "director": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Director"
          },
          "release_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release Year"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "category",
          "production_title",
          "role_name",
          "id"
        ],
        "title": "CreditResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MediaAssetListResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "assets": {
            "items": {
              "$ref": "#/components/schemas/MediaAssetResponse"
            },
            "type": "array",
            "title": "Assets"
          }
        },
        "type": "object",
        "required": [
          "total",
          "assets"
        ],
        "title": "MediaAssetListResponse"
      },
      "MediaAssetResponse": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Url"
          },
          "full_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Url"
          },
          "download_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Download Url"
          },
          "embed_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Embed Code"
          },
          "is_primary": {
            "type": "boolean",
            "title": "Is Primary",
            "default": false
          },
          "display_order": {
            "type": "integer",
            "title": "Display Order",
            "default": 0
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "title",
          "media_type",
          "id"
        ],
        "title": "MediaAssetResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}