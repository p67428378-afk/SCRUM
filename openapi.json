{
  "openapi": "3.1.0",
  "info": {
    "title": "DG Cluster Assortment Advisor API",
    "description": "Decision-support tool for Dollar General category managers",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/kpis": {
      "get": {
        "summary": "Read Kpis",
        "operationId": "read_kpis_api_v1_kpis_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KPISummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sku-performance": {
      "get": {
        "summary": "Read Sku Performance",
        "operationId": "read_sku_performance_api_v1_sku_performance_get",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sort By"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sort Order"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SKUPerformanceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios/{scenario_name}": {
      "get": {
        "summary": "Read Scenario",
        "operationId": "read_scenario_api_v1_scenarios__scenario_name__get",
        "parameters": [
          {
            "name": "scenario_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment-plans": {
      "post": {
        "summary": "Create Plan",
        "operationId": "create_plan_api_v1_assortment_plans_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssortmentPlanCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssortmentPlanResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssortmentPlanCreate": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "plan_details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Plan Details"
          }
        },
        "type": "object",
        "required": [
          "scenario_name",
          "plan_details"
        ],
        "title": "AssortmentPlanCreate"
      },
      "AssortmentPlanResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "plan_details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Plan Details"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "scenario_name",
          "plan_details",
          "created_at"
        ],
        "title": "AssortmentPlanResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KPISummary": {
        "properties": {
          "sales_per_linear_ft": {
            "type": "number",
            "title": "Sales Per Linear Ft"
          },
          "private_brand_pct": {
            "type": "number",
            "title": "Private Brand Pct"
          },
          "in_stock_rate": {
            "type": "number",
            "title": "In Stock Rate"
          },
          "shelf_capacity": {
            "type": "number",
            "title": "Shelf Capacity"
          }
        },
        "type": "object",
        "required": [
          "sales_per_linear_ft",
          "private_brand_pct",
          "in_stock_rate",
          "shelf_capacity"
        ],
        "title": "KPISummary"
      },
      "SKUPerformanceItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "brand": {
            "type": "string",
            "title": "Brand"
          },
          "is_private_brand": {
            "type": "boolean",
            "title": "Is Private Brand"
          },
          "sales": {
            "type": "number",
            "title": "Sales"
          },
          "margin_pct": {
            "type": "number",
            "title": "Margin Pct"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sku",
          "name",
          "brand",
          "is_private_brand",
          "sales",
          "margin_pct",
          "status"
        ],
        "title": "SKUPerformanceItem"
      },
      "SKUPerformanceResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SKUPerformanceItem"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "limit"
        ],
        "title": "SKUPerformanceResponse"
      },
      "ScenarioResponse": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "projected_sales_growth": {
            "type": "number",
            "title": "Projected Sales Growth"
          },
          "projected_private_brand_pct": {
            "type": "number",
            "title": "Projected Private Brand Pct"
          },
          "projected_shelf_capacity_pct": {
            "type": "number",
            "title": "Projected Shelf Capacity Pct"
          },
          "sku_actions": {
            "items": {
              "$ref": "#/components/schemas/ScenarioSKUAction"
            },
            "type": "array",
            "title": "Sku Actions"
          }
        },
        "type": "object",
        "required": [
          "scenario_name",
          "projected_sales_growth",
          "projected_private_brand_pct",
          "projected_shelf_capacity_pct",
          "sku_actions"
        ],
        "title": "ScenarioResponse"
      },
      "ScenarioSKUAction": {
        "properties": {
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "action": {
            "type": "string",
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "sku",
          "action"
        ],
        "title": "ScenarioSKUAction"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}