{
  "openapi": "3.1.0",
  "info": {
    "title": "DG Cluster Assortment Advisor API",
    "description": "Decision-support tool for Dollar General category managers",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/kpis": {
      "get": {
        "summary": "Get Kpis",
        "operationId": "get_kpis_api_v1_kpis_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KPIResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/skus": {
      "get": {
        "summary": "Get Skus",
        "operationId": "get_skus_api_v1_skus_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SKUListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios/{scenario_name}": {
      "get": {
        "summary": "Get Scenario",
        "operationId": "get_scenario_api_v1_scenarios__scenario_name__get",
        "parameters": [
          {
            "name": "scenario_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/approvals": {
      "post": {
        "summary": "Submit Approval",
        "operationId": "submit_approval_api_v1_approvals_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/approvals/{approval_id}": {
      "get": {
        "summary": "Get Approval",
        "operationId": "get_approval_api_v1_approvals__approval_id__get",
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Approval Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditTrailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprovalRequest": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          }
        },
        "type": "object",
        "required": [
          "scenario_name"
        ],
        "title": "ApprovalRequest"
      },
      "ApprovalResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "user": {
            "type": "string",
            "title": "User"
          }
        },
        "type": "object",
        "required": [
          "success",
          "message",
          "transaction_id",
          "submitted_at",
          "user"
        ],
        "title": "ApprovalResponse"
      },
      "AuditTrailResponse": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "user_name": {
            "type": "string",
            "title": "User Name"
          },
          "sku_action_summary": {
            "$ref": "#/components/schemas/SKUActionSummary"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "scenario_name",
          "submitted_at",
          "user_name",
          "sku_action_summary"
        ],
        "title": "AuditTrailResponse"
      },
      "Guardrails": {
        "properties": {
          "margin_threshold": {
            "type": "string",
            "title": "Margin Threshold"
          },
          "private_brand_goal": {
            "type": "string",
            "title": "Private Brand Goal"
          },
          "shelf_capacity_check": {
            "type": "string",
            "title": "Shelf Capacity Check"
          }
        },
        "type": "object",
        "required": [
          "margin_threshold",
          "private_brand_goal",
          "shelf_capacity_check"
        ],
        "title": "Guardrails"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KPIResponse": {
        "properties": {
          "sales_per_linear_ft": {
            "type": "number",
            "title": "Sales Per Linear Ft"
          },
          "private_brand_share": {
            "type": "number",
            "title": "Private Brand Share"
          },
          "in_stock_rate": {
            "type": "number",
            "title": "In Stock Rate"
          },
          "shelf_capacity_utilization": {
            "type": "number",
            "title": "Shelf Capacity Utilization"
          }
        },
        "type": "object",
        "required": [
          "sales_per_linear_ft",
          "private_brand_share",
          "in_stock_rate",
          "shelf_capacity_utilization"
        ],
        "title": "KPIResponse"
      },
      "SKUActionSummary": {
        "properties": {
          "grow": {
            "type": "integer",
            "title": "Grow"
          },
          "maintain": {
            "type": "integer",
            "title": "Maintain"
          },
          "reduce": {
            "type": "integer",
            "title": "Reduce"
          },
          "swap": {
            "type": "integer",
            "title": "Swap"
          }
        },
        "type": "object",
        "required": [
          "grow",
          "maintain",
          "reduce",
          "swap"
        ],
        "title": "SKUActionSummary"
      },
      "SKUItem": {
        "properties": {
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "brand_type": {
            "type": "string",
            "title": "Brand Type"
          },
          "weekly_sales": {
            "type": "number",
            "title": "Weekly Sales"
          },
          "margin_percent": {
            "type": "number",
            "title": "Margin Percent"
          },
          "shelf_space": {
            "type": "string",
            "title": "Shelf Space"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "sku_id",
          "product_name",
          "brand_type",
          "weekly_sales",
          "margin_percent",
          "shelf_space",
          "status"
        ],
        "title": "SKUItem"
      },
      "SKUListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SKUItem"
            },
            "type": "array",
            "title": "Items"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "limit",
          "page",
          "total"
        ],
        "title": "SKUListResponse"
      },
      "ScenarioResponse": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "projected_sales_change": {
            "type": "number",
            "title": "Projected Sales Change"
          },
          "projected_private_brand_share": {
            "type": "number",
            "title": "Projected Private Brand Share"
          },
          "projected_shelf_space_change": {
            "type": "number",
            "title": "Projected Shelf Space Change"
          },
          "sku_action_summary": {
            "$ref": "#/components/schemas/SKUActionSummary"
          },
          "guardrails": {
            "$ref": "#/components/schemas/Guardrails"
          }
        },
        "type": "object",
        "required": [
          "scenario_name",
          "projected_sales_change",
          "projected_private_brand_share",
          "projected_shelf_space_change",
          "sku_action_summary",
          "guardrails"
        ],
        "title": "ScenarioResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}