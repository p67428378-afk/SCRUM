{
  "openapi": "3.1.0",
  "info": {
    "title": "Secure Peer-to-Peer (P2P) Money Transfer API",
    "description": "Backend API for secure real-time P2P transfers with fraud detection and balance checks.",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
