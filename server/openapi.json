    "/api/v1/transfers": {
      "post": {
        "tags": [
          "Transfers"
        ],
        "summary": "Create Transfer",
        "description": "Execute a secure P2P money transfer.\n\n- **sender_id**: Account ID of the sender\n- **receiver_id**: Account ID of the recipient\n- **amount**: Positive numeric value in USD (max $10,000.00)",
        "operationId": "create_transfer_api_v1_transfers_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Business rule error (Fraud exceeded or Insufficient funds)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      },
      "get": {
        "tags": [
          "Transfers"
        ],
        "summary": "List Transfers",
        "description": "Retrieve transfer history with optional user filter and pagination.",
        "operationId": "list_transfers_api_v1_transfers_get",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional filter by user ID (sender or receiver)",
              "title": "User Id"
            },
            "description": "Optional filter by user ID (sender or receiver)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferResponse"
                  },
                  "title": "Response List Transfers Api V1 Transfers Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transfers/{transfer_id}": {
      "get": {
        "tags": [
          "Transfers"
        ],
        "summary": "Get Transfer",
        "description": "Get single transfer details by transaction UUID.",
        "operationId": "get_transfer_api_v1_transfers__transfer_id__get",
        "parameters": [
          {
            "name": "transfer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Transfer Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "404": {
            "description": "Transfer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/balance/{account_id}": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get Balance",
        "description": "Get current account information and balance for an account ID.",
        "operationId": "get_balance_api_v1_balance__account_id__get",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Account Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accounts/{account_id}/balance": {
      "get": {
        "tags": [
          "Accounts"
        ],
        "summary": "Get Balance",
        "description": "Get current account information and balance for an account ID.",
        "operationId": "get_balance_api_v1_accounts__account_id__balance_get",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Account Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Account identifier"
          },
          "balance": {
            "type": "number",
            "title": "Balance",
            "description": "Current available balance"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Email associated with the account"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "User role",
            "default": "user"
          }
        },
        "type": "object",
        "required": [
          "id",
          "balance"
        ],
        "title": "AccountResponse"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Detailed error message"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TransferCreate": {
        "properties": {
          "sender_id": {
            "type": "string",
            "minLength": 1,
            "title": "Sender Id",
            "description": "Sender user or account ID"
          },
          "receiver_id": {
            "type": "string",
            "minLength": 1,
            "title": "Receiver Id",
            "description": "Receiver user or account ID"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "description": "Transfer amount in USD (must be positive)"
          }
        },
        "type": "object",
        "required": [
          "sender_id",
          "receiver_id",
          "amount"
        ],
        "title": "TransferCreate",
        "example": {
          "amount": 250.0,
          "receiver_id": "usr_98765",
          "sender_id": "usr_12345"
        }
      },
      "TransferResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique transfer UUID"
          },
          "sender_id": {
            "type": "string",
            "title": "Sender Id",
            "description": "Sender ID"
          },
          "receiver_id": {
            "type": "string",
            "title": "Receiver Id",
            "description": "Receiver ID"
          },
          "amount": {
            "type": "number",
            "title": "Amount",
            "description": "Transfer amount"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Transfer status (e.g., COMPLETED)"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp when transfer was initiated"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At",
            "description": "Timestamp when transfer was last updated"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sender_id",
          "receiver_id",
          "amount",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "TransferResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}