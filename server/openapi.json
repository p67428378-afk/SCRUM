{
  "openapi": "3.1.0",
  "info": {
    "title": "DG Cluster Assortment Advisor API",
    "description": "API for Dollar General category managers to optimize product assortments.",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/kpis": {
      "get": {
        "tags": [
          "Assortment"
        ],
        "summary": "Read Kpis",
        "description": "Retrieves the four main KPI values for the header strip.",
        "operationId": "read_kpis_api_v1_assortment_kpis_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KPIResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/skus": {
      "get": {
        "tags": [
          "Assortment"
        ],
        "summary": "Read Skus",
        "description": "Retrieves the list of all snack SKUs with their performance data.",
        "operationId": "read_skus_api_v1_assortment_skus_get",
        "parameters": [
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sort By"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Order"
            }
          },
          {
            "name": "filter_status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Filter Status"
            }
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SKUResponse"
                  },
                  "title": "Response Read Skus Api V1 Assortment Skus Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/scenarios": {
      "get": {
        "tags": [
          "Assortment"
        ],
        "summary": "Read Scenarios",
        "description": "Retrieves the projected impact metrics for each of the three predefined scenarios.",
        "operationId": "read_scenarios_api_v1_assortment_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScenarioResponse"
                  },
                  "type": "array",
                  "title": "Response Read Scenarios Api V1 Assortment Scenarios Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/submit": {
      "post": {
        "tags": [
          "Assortment"
        ],
        "summary": "Submit Assortment",
        "description": "Submits the category manager's chosen assortment scenario for approval and auditing.",
        "operationId": "submit_assortment_api_v1_assortment_submit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmissionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GuardrailCheck": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "GuardrailCheck"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "KPIResponse": {
        "properties": {
          "sales_per_linear_ft": {
            "type": "number",
            "title": "Sales Per Linear Ft"
          },
          "private_brand_percentage": {
            "type": "number",
            "title": "Private Brand Percentage"
          },
          "in_stock_rate": {
            "type": "number",
            "title": "In Stock Rate"
          },
          "shelf_capacity": {
            "type": "number",
            "title": "Shelf Capacity"
          }
        },
        "type": "object",
        "required": [
          "sales_per_linear_ft",
          "private_brand_percentage",
          "in_stock_rate",
          "shelf_capacity"
        ],
        "title": "KPIResponse"
      },
      "SKUAction": {
        "properties": {
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "sku_id",
          "action"
        ],
        "title": "SKUAction"
      },
      "SKUResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "sku_id": {
            "type": "string",
            "title": "Sku Id"
          },
          "weekly_sales": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weekly Sales"
          },
          "profit_margin": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profit Margin"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "product_name",
          "sku_id"
        ],
        "title": "SKUResponse"
      },
      "ScenarioResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "projected_sales_lift": {
            "type": "number",
            "title": "Projected Sales Lift"
          },
          "private_brand_impact": {
            "type": "number",
            "title": "Private Brand Impact"
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/SKUAction"
            },
            "type": "array",
            "title": "Actions"
          },
          "guardrails": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/GuardrailCheck"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guardrails"
          }
        },
        "type": "object",
        "required": [
          "name",
          "projected_sales_lift",
          "private_brand_impact",
          "actions"
        ],
        "title": "ScenarioResponse"
      },
      "SubmissionRequest": {
        "properties": {
          "scenario_name": {
            "type": "string",
            "title": "Scenario Name"
          },
          "submitted_by": {
            "type": "string",
            "format": "email",
            "title": "Submitted By"
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/SKUAction"
            },
            "type": "array",
            "title": "Actions"
          }
        },
        "type": "object",
        "required": [
          "scenario_name",
          "submitted_by",
          "actions"
        ],
        "title": "SubmissionRequest"
      },
      "SubmissionResponse": {
        "properties": {
          "submission_id": {
            "type": "string",
            "title": "Submission Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "guardrails_passed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Guardrails Passed",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "submission_id",
          "status",
          "timestamp"
        ],
        "title": "SubmissionResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}